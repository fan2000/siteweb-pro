generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OfferKind {
  AFFILIATE
  DROPSHIP
  SERVICE
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(254)
  passwordHash      String
  emailVerifiedAt   DateTime?
  role              Role      @default(CUSTOMER)
  mfaSecret         String?
  mfaEnabledAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  recoveryCodes     RecoveryCode[]
  verificationTokens VerificationToken[]
  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  csrfHash  String   @db.Char(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  expiresAt DateTime
  consumedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model RecoveryCode {
  id        String   @id @default(uuid()) @db.Uuid
  codeHash  String
  userId    String   @db.Uuid
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
}

model Offer {
  id          String    @id @db.VarChar(80)
  name        String    @db.VarChar(180)
  category    String    @db.VarChar(80)
  kind        OfferKind
  priceCents  Int
  currency    String    @default("EUR") @db.Char(3)
  description String    @db.VarChar(1000)
  image       String    @db.VarChar(500)
  demo        Boolean   @default(true)
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([active, category])
}
